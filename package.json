{
  "name": "dsh-evolution",
  "version": "0.1.0",
  "description": "Self-evolution system for DeepSeek Harness: experience collection, pattern analysis, candidate generation, benchmarking, promotion and rollback.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "self-evolution",
    "experience",
    "benchmark",
    "promotion"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
